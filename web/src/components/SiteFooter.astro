---
import { withBase } from '../lib/urls';
import { currentEdition } from '../lib/editions';

interface Props {
  lang?: 'en' | 'ar';
}
const { lang = 'en' } = Astro.props;
const year = new Date().getFullYear();

const edNum = String(currentEdition.number).padStart(2, '0');
const edNumAr = currentEdition.number.toLocaleString('ar-EG', { minimumIntegerDigits: 2 });

const copy = {
  en: {
    issue: `Edition ${edNum} · ${year}`,
    rights: `© ${year} Madār — an editorial publication, independently operated.`,
    closing: 'Made in spite of, not because of.',
    rss: 'RSS',
    contact: 'Contact',
    aboutLabel: 'About',
    aboutHref: withBase('/about/'),
    editionsLabel: 'Editions',
    editionsHref: withBase('/editions/'),
    homeHref: withBase('/'),
    otherLangHref: withBase('/ar/'),
    otherLangLabel: 'العربية',
    rssHref: withBase('/rss.xml'),
  },
  ar: {
    issue: `الإصدار ${edNumAr} · ${year.toLocaleString('ar-EG', { useGrouping: false })}`,
    rights: `© ${year} مدار — منشور تحريري مستقل.`,
    closing: 'صُنع رغمًا عن الظروف، لا بفضلها.',
    rss: 'RSS',
    contact: 'اتصل',
    aboutLabel: 'عن المنشور',
    // See SiteHeader: /ar/about/ has never existed. Resolves to the Arabic
    // home's About section until the standalone AR About page ships.
    aboutHref: withBase('/ar/#about'),
    editionsLabel: 'الإصدارات',
    editionsHref: withBase('/ar/editions/'),
    homeHref: withBase('/ar/'),
    otherLangHref: withBase('/'),
    otherLangLabel: 'English',
    // The Arabic footer points at the Arabic feed (fixed 2026-08-16 — it had
    // pointed at the English path, which was itself a 404 until that date).
    rssHref: withBase('/ar/rss.xml'),
  },
}[lang];
---

<footer class="site-footer">
  <div class="container site-footer__inner">

    <div class="site-footer__cell site-footer__cell--issue">
      <p class="kicker">{copy.issue}</p>
      <p class="site-footer__closing">{copy.closing}</p>
    </div>

    <div class="site-footer__cell site-footer__cell--mark">
      <a href={copy.homeHref} class="site-footer__mark" aria-label="Madār — home">
        <span class="mark-latin" lang="en">Madār</span>
        <span aria-hidden="true" class="mark-divider">·</span>
        <span class="mark-arabic" lang="ar" dir="rtl">مدار</span>
      </a>
      <p class="site-footer__rights mono sage">{copy.rights}</p>
    </div>

    <div class="site-footer__cell site-footer__cell--nav">
      <ul class="site-footer__links">
        <li><a href={copy.editionsHref} class="uppercase">{copy.editionsLabel}</a></li>
        <li><a href={copy.aboutHref} class="uppercase">{copy.aboutLabel}</a></li>
        <li><a href={copy.otherLangHref} class="uppercase" hreflang={lang === 'ar' ? 'en' : 'ar'} lang={lang === 'ar' ? 'en' : 'ar'}>{copy.otherLangLabel}</a></li>
        <li><a href={copy.rssHref} class="uppercase" lang="en">{copy.rss}</a></li>
      </ul>
    </div>

  </div>
</footer>

<style>
  .site-footer {
    margin-block-start: 4rem;
    padding-block: 2rem 3rem;
    border-block-start: 1px solid var(--color-rule);
  }
  .site-footer__inner {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    gap: 2rem;
    align-items: start;
  }
  .site-footer__cell--issue { justify-self: start; }
  .site-footer__cell--mark { justify-self: center; text-align: center; }
  .site-footer__cell--nav   { justify-self: end; }

  .site-footer__closing {
    margin-block-start: 0.5rem;
    max-width: 22ch;
    font-family: var(--font-body);
    font-style: italic;
    font-size: 0.95rem;
    color: var(--color-muted);
  }
  /* The Arabic strapline is composed in Arabic (`copy.ar.closing`) and was
     being set in Newsreader Italic — a Latin-only face — so it rendered from
     the system serif while the browser fetched 146,872 bytes to draw none of
     it. Measured 2026-10-17: the single largest font request on every Arabic
     page, for nine words it cannot render. Italic is reset rather than carried
     because Arabic has no italic convention, which this stylesheet already
     says once, at `[dir="rtl"] .pullquote { font-style: normal }`. */
  /* `:global()` on the ancestor is load-bearing, not decoration. A bare
     `[dir="rtl"]` in a component's scoped style gets the component's own
     `data-astro-cid` attribute attached to it, and `dir="rtl"` lives on
     <html>, which this component does not render and therefore never carries
     that attribute — so the rule compiles to a selector that cannot match any
     document. `ShareRail.astro` has used `:global([dir="rtl"])` since it was
     written; this file did not, and that is why the two rules below it had
     never once applied to an Arabic page. */
  :global([dir="rtl"]) .site-footer__closing {
    font-family: var(--font-arabic);
    font-style: normal;
  }

  .site-footer__mark {
    text-decoration: none;
    color: var(--color-ink);
    display: inline-flex;
    align-items: baseline;
    gap: 0.5rem;
  }
  .mark-latin {
    font-family: var(--font-display);
    font-size: 22px;
    font-weight: 500;
    letter-spacing: -0.005em;
  }
  .mark-divider { opacity: 0.35; }
  .mark-arabic {
    font-family: var(--font-arabic);
    font-size: 20px;
    line-height: 1;
  }
  .site-footer__rights {
    margin-block-start: 0.75rem;
    font-size: 10.5px;
    letter-spacing: 0.04em;
    line-height: 1.55;
  }

  .site-footer__links {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 0.6rem;
  }
  /* Never applied before 2026-10-17 — see the `:global()` note above. */
  :global([dir="rtl"]) .site-footer__links { align-items: flex-start; }
  .site-footer__links a { text-decoration: none; color: var(--color-ink); opacity: 0.78; }
  .site-footer__links a:hover { opacity: 1; color: var(--color-orange); }

  @media (max-width: 720px) {
    .site-footer__inner {
      grid-template-columns: 1fr;
      gap: 1.5rem;
      text-align: center;
    }
    .site-footer__cell--issue,
    .site-footer__cell--mark,
    .site-footer__cell--nav { justify-self: center; }
    .site-footer__links { flex-direction: row; align-items: center; flex-wrap: wrap; gap: 1rem; }
    :global([dir="rtl"]) .site-footer__links { align-items: center; }
  }
</style>
