---
import Base from '../../../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { withBase } from '../../../lib/urls';
import { byDateThenSlug } from '../../../lib/order';
import { editions } from '../../../lib/editions';
import { inlineCover } from '../../../lib/inlineCover';
import { countryAr } from '../../../lib/i18n-geo';

// ---------------------------------------------------------------------------
// Editions index (AR, RTL) — mirror of the English page over the Arabic
// collection. Article body pages are untouched.
// ---------------------------------------------------------------------------
const all = await getCollection('articles-ar', ({ data }) => data.approved !== false);

const dateFormatter = new Intl.DateTimeFormat('ar-EG', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
  // A frontmatter date is a bare YYYY-MM-DD, which `z.coerce.date()` parses as
  // UTC midnight. Without an explicit timeZone this formatter asks the BUILD
  // MACHINE what day that instant is, and every runner behind UTC answers with
  // the day before: a 2026-07-07 piece renders "July 6, 2026" on a Los Angeles
  // runner, on 116 of 121 pages. Ruling #60 — the date is pinned to the zone the
  // value was parsed in, never to the machine that formats it.
  timeZone: 'UTC',
});

// Group pieces by edition number.
const byEdition = new Map<number, typeof all>();
for (const piece of all) {
  const n = piece.data.edition;
  if (n == null) continue;
  if (!byEdition.has(n)) byEdition.set(n, []);
  byEdition.get(n)!.push(piece);
}

// Render order: current edition first, then closed editions by descending number.
const ordered = [...editions].sort((a, b) => {
  if (a.status === 'current' && b.status !== 'current') return -1;
  if (b.status === 'current' && a.status !== 'current') return 1;
  return b.number - a.number;
});

const blocks = ordered.map((e) => {
  const pieces = (byEdition.get(e.number) ?? [])
    .slice()
    .sort(byDateThenSlug);
  return { e, pieces };
});
---

<Base title="الإصدارات · مدار" lang="ar" ogImage="/og/brand-card.png" alternate={{ en: '/editions/', ar: '/ar/editions/' }}>
  <article class="editions container">
    <header class="editions__head">
      <p class="kicker" lang="ar" dir="rtl">الأرشيف</p>
      <h1 class="editions__title" lang="ar" dir="rtl">الإصدارات</h1>
      <p class="editions__intro measure" lang="ar" dir="rtl">
        تَصدرُ «مدار» في إصداراتٍ شهريّة. يَجمعُ كلُّ إصدارٍ موادَّه تحت سؤالٍ
        تحريريٍّ واحد، باللغتَين.
      </p>
    </header>

    {blocks.map(({ e, pieces }) => (
      <section
        class="edition"
        data-motif={e.motif}
        style={`--ed-ground:${e.ground};--ed-accent:${e.accent};`}
      >
        {inlineCover(e.cover) && (
          <div class="edition__cover" set:html={inlineCover(e.cover)} />
        )}
        <div class="edition__masthead">
          <span class="edition__numeral" aria-hidden="true">
            {String(e.number).padStart(2, '0')}
          </span>
          <div class="edition__framing">
            <div class="edition__kickerline">
              <span class="edition__period">{e.periodAr}</span>
              {e.status === 'current' && (
                <span class="edition__tag" lang="ar" dir="rtl">الإصدار الحالي</span>
              )}
            </div>
            <p class="edition__theme" lang="ar" dir="rtl">{e.themeAr}</p>
            {e.motif === 'horizon' ? (
              <svg class="edition__motif" width="84" height="12" viewBox="0 0 84 12" aria-hidden="true">
                <line x1="2" y1="6" x2="82" y2="6" stroke="currentColor" stroke-width="1" />
                <line x1="2" y1="1" x2="2" y2="11" stroke="currentColor" stroke-width="1" />
                <line x1="82" y1="1" x2="82" y2="11" stroke="currentColor" stroke-width="1" />
              </svg>
            ) : e.motif === 'throughline' ? (
              <svg class="edition__motif" width="84" height="12" viewBox="0 0 84 12" aria-hidden="true">
                <path d="M4 6 H34 L39 2 L44 10 L49 6 H80" fill="none" stroke="currentColor" stroke-width="1" />
                <line x1="2" y1="1.5" x2="2" y2="10.5" stroke="currentColor" stroke-width="1" />
                <line x1="82" y1="1.5" x2="82" y2="10.5" stroke="currentColor" stroke-width="1" />
              </svg>
            ) : (
              <svg class="edition__motif" width="84" height="12" viewBox="0 0 84 12" aria-hidden="true">
                <circle cx="6" cy="6" r="3.5" fill="none" stroke="currentColor" stroke-width="1" />
                <line x1="9.5" y1="6" x2="74.5" y2="6" stroke="currentColor" stroke-width="1" />
                <circle cx="78" cy="6" r="3.5" fill="none" stroke="currentColor" stroke-width="1" />
              </svg>
            )}
          </div>
        </div>

        {pieces.length > 0 ? (
          <ul class="edition__pieces">
            {pieces.map((piece) => {
              const href = withBase(`/ar/articles/${piece.id}/`);
              return (
                <li class="piece">
                  <a href={href} class="piece__link">
                    <span class="piece__meta">
                      <span class="piece__country" lang="ar" dir="rtl">{countryAr(piece.data.country)}</span>
                      <span class="piece__date">{dateFormatter.format(piece.data.date)}</span>
                    </span>
                    <h2 class="piece__title" lang="ar" dir="rtl">{piece.data.title}</h2>
                  </a>
                </li>
              );
            })}
          </ul>
        ) : (
          <p class="edition__empty muted" lang="ar" dir="rtl">لا توجد موادُّ في هذا الإصدار بعد.</p>
        )}
      </section>
    ))}

    {/* ---- Standing pieces, outside the numbered editions ----
         Added 2026-11-01 as the growth action, and it closes a gap that was
         left open on purpose for 76 days. The ENGLISH editions index has
         carried this section since 2026-08-25, when the orphan audit found
         /valence/ served with no inbound edge at all. The Arabic side was
         recorded that day as an editorial question and not a QA fix
         (agents/growth/2026-08-17-orphan-page-audit-valence.md), and nobody
         came back to it. Measured today: exactly ONE page in the whole site
         linked to /madar/valence/ and ZERO of them were Arabic — so half the
         publication had no path to a document the sitemap claims, and
         qa_reachability was correctly silent, because it asks whether a page is
         reachable from its OWN language's front door and valence has only one.

         The editorial question is answered rather than dodged. The instrument
         is in English, so the title is marked `lang="en" dir="ltr"` and the
         Arabic reader is told what they are clicking into BEFORE they click,
         instead of being sent to an English page by a link that looks Arabic.
         That is #86 and #101's discipline applied to a link rather than to a
         name: where one edition can answer a question the other cannot, say so
         in the edition that cannot.

         Heading level mirrors the English page deliberately — h2 section, h3
         item — which gives the Arabic page its first real section outline and
         keeps items 54/57/58's class closed (h1 -> h2 -> h3, no skip).      */}
    <section class="standing" aria-labelledby="standing-head-ar">
      <p class="kicker" lang="ar" dir="rtl">موادُّ دائمة</p>
      <h2 id="standing-head-ar" class="standing__title" lang="ar" dir="rtl">خارج الإصدارات</h2>
      <ul class="edition__pieces">
        <li class="piece">
          <a href={withBase('/valence/')} class="piece__link">
            <span class="piece__meta">
              <span class="piece__country" lang="ar" dir="rtl">تفاعُلي</span>
              <span class="piece__date" lang="ar" dir="rtl">أغسطس ٢٠٢٦</span>
            </span>
            <h3 class="piece__title"><span lang="en" dir="ltr">VALENCE — The Chemistry of Education</span></h3>
            <p class="standing__note" lang="ar" dir="rtl">أداةٌ تفاعليةٌ قائمةٌ بذاتها، نصُّها بالإنجليزية.</p>
          </a>
        </li>
      </ul>
    </section>
  </article>
</Base>

<style>
  .editions { padding-block: var(--space-lg) var(--space-2xl); }
  .editions__head {
    padding-block: var(--space-xl) var(--space-lg);
    border-block-end: 1px solid var(--color-rule);
    margin-block-end: var(--space-xl);
  }
  .editions__title { margin-block-start: var(--space-sm); }
  .editions__intro {
    margin-block-start: var(--space-md);
    font-family: var(--font-arabic);
    font-size: 18.5px;
    line-height: 1.95;
    color: var(--color-muted);
  }

  /* ---- Themed edition block ---- */
  .edition {
    background: var(--ed-ground);
    border: 1px solid var(--color-rule-soft);
    border-radius: 2px;
    padding: 2.5rem 2.5rem 2rem;
    margin-block-end: 2.5rem;
    color: var(--color-ink);
  }
  .edition__cover {
    max-width: 320px;
    margin-inline: auto;
    margin-block-end: 2rem;
  }
  .edition__cover :global(svg) {
    width: 100%;
    height: auto;
    display: block;
  }
  .edition__masthead {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 2rem;
    align-items: start;
    padding-block-end: 1.75rem;
    margin-block-end: 1.5rem;
    border-block-end: 1px solid var(--color-rule);
  }
  .edition__numeral {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(64px, 9vw, 108px);
    line-height: 0.85;
    letter-spacing: -0.02em;
    color: var(--ed-accent);
  }
  .edition__framing { display: flex; flex-direction: column; gap: 0.85rem; }
  .edition__kickerline {
    display: flex;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
  }
  .edition__period {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.16em;
    color: var(--ed-accent);
    font-weight: 500;
  }
  .edition__tag {
    font-family: var(--font-arabic);
    font-size: 13px;
    color: var(--ed-accent);
    border: 1px solid var(--ed-accent);
    border-radius: 2px;
    padding: 0.2rem 0.6rem;
    font-weight: 500;
  }
  .edition__theme {
    margin: 0;
    font-family: var(--font-arabic-display);
    font-weight: 500;
    font-size: clamp(22px, 2.4vw, 30px);
    line-height: 1.4;
    max-width: 44ch;
  }
  .edition__motif { color: var(--ed-accent); height: 12px; width: 84px; }

  /* ---- Standing pieces, outside the numbered editions (added 2026-11-01) ----
     The Arabic counterpart of the EN editions index's own `.standing` block,
     restated here rather than lifted into global.css ON PURPOSE: a rule
     restated per component is exactly the shape ruling #123 names this
     morning, so the choice is deliberate and the reason is written down. These
     are furniture for two pages; promoting them would put a third unreachable
     statement into the global layer beside `hr.rule` and `.pullquote`, which
     is the defect #123 describes rather than a fix for it. If a third page
     ever needs them, that is the moment they move. */
  .standing {
    border-block-start: 1px solid var(--color-rule);
    padding-block-start: var(--space-xl);
    margin-block-start: var(--space-lg);
  }
  .standing__title {
    margin-block: var(--space-sm) var(--space-lg);
    /* --font-arabic-display, NOT --font-display. The first draft of this rule
       was copied from the English editions index and painted
       «خارج الإصدارات» in Cormorant Garamond, a Latin serif that covers no
       Arabic at all, so a system font did the work. Found by LOOKING at the
       render (08-23 clause 2), not by a gate: qa_font_payload limb 2 is
       correctly silent because a fallback is not a dead FETCH, and the class
       it does measure — a painted Arabic run whose stack names no bundled
       Arabic family — is printed and not asserted (standing-queue item 40),
       so this would have become instance 90 of 89. */
    font-family: var(--font-arabic-display);
  }
  /* The instrument's name is English and must be set in the English display
     face, inside an RTL document. Without this it inherits Cairo from
     .piece__title and Latin text is painted by an Arabic typeface — the exact
     mirror of the defect above, in one element. `dir="ltr"` on the span
     isolates the bidi run; this isolates the typography. */
  .standing .piece__title [lang="en"] {
    font-family: var(--font-display);
  }
  .standing__note {
    margin-block-start: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.04em;
    color: var(--color-muted);
  }

  .edition__pieces {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.75rem 3rem;
  }
  .piece__link { display: block; text-decoration: none; color: var(--color-ink); }
  .piece__meta {
    display: flex;
    gap: 1rem;
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .piece__country { color: var(--ed-accent); font-weight: 500; }
  .piece__date { color: var(--color-ink); opacity: 0.55; }
  .piece__title {
    margin-block: 0.5rem 0;
    font-family: var(--font-arabic-display);
    font-weight: 500;
    font-size: 24px;
    line-height: 1.45;
  }
  .piece__link:hover .piece__title { color: var(--ed-accent); }
  .edition__empty { margin: 0; }

  @media (max-width: 720px) {
    .edition { padding: 1.75rem 1.5rem; }
    .edition__masthead { grid-template-columns: 1fr; gap: 1rem; }
    .edition__pieces { grid-template-columns: 1fr; gap: 1.5rem; }
  }
</style>
