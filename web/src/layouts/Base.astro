---
import '../styles/global.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { withBase } from '../lib/urls';

interface Props {
  title: string;
  description?: string;
  lang?: 'en' | 'ar';
  ogImage?: string;
  /**
   * If true, suppress the SiteHeader (used when a page renders its own
   * editorial masthead, e.g. an article page).
   */
  noHeader?: boolean;
  /**
   * Head-level hreflang pair (site-absolute paths WITHOUT the base prefix,
   * e.g. { en: '/articles/slug/', ar: '/ar/articles/slug/' }).
   * Only pass when BOTH language versions exist — a pair pointing at a
   * missing page is worse than no pair. The sitemap already carries
   * xhtml:link alternates; this adds the belt-and-suspenders head signal
   * (Growth audit, 2026-07-11). x-default resolves to the EN page.
   */
  alternate?: { en: string; ar: string };
  /**
   * schema.org JSON-LD for this page, already built by the caller.
   *
   * Added 2026-08-23 (Growth). Until today NOT ONE of the 82 pages carried
   * structured data. The head is otherwise strong — canonical, reciprocal
   * hreflang, x-default, absolute raster og:image, twitter card, robots — but
   * all of that describes the page's *identity*; none of it describes what the
   * page IS. For this publication that gap is expensive in a specific way: our
   * single differentiator is that every piece stands on named primary sources,
   * and `schema.org/citation` is the field that makes that legible to a
   * machine. We were shipping the evidence and hiding the bibliography.
   *
   * Passed in rather than assembled here so the layout stays presentational
   * and each route describes its own content type.
   */
  /** One node or several (e.g. Article + BreadcrumbList); an array is valid JSON-LD. */
  jsonLd?: Record<string, unknown> | Array<Record<string, unknown>>;
  /**
   * Open Graph object type. Added 2026-08-24.
   *
   * Until today `og:type` was hardcoded to "article" for EVERY page — the
   * English home page, the Arabic home page, About, and both editions indexes
   * all told every scraper they were a single article. Shared, they invited a
   * reader to "read" a page that is a list.
   *
   * The default is deliberately 'website', the safe direction: a listing
   * mislabelled as a website is inert, an index mislabelled as an article is a
   * false claim. Article routes opt in explicitly.
   */
  pageType?: 'website' | 'article';
}

const {
  title,
  description = 'An editorial publication on early childhood and K-12 education, written and made in English and Arabic.',
  lang = 'en',
  ogImage,
  noHeader = false,
  alternate,
  jsonLd,
  pageType = 'website',
} = Astro.props;

const dir = lang === 'ar' ? 'rtl' : 'ltr';
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const alternateEN = alternate ? new URL(withBase(alternate.en), Astro.site).href : null;
const alternateAR = alternate ? new URL(withBase(alternate.ar), Astro.site).href : null;
// og:image / twitter:image must be ABSOLUTE for social scrapers (Growth audit,
// 2026-07-16). The contract used to be "callers pass base-prefixed paths" — a
// contract stated in a comment is a declaration, and on 2026-08-26 five new
// callers passed `/og/brand-card.png` unprefixed, which would have served a
// 404 card from every front door. Caught by qa_live_drift's first bite
// (2026-08-27) before it deployed. So the base is now DERIVED here, per ruling
// #36: a site-absolute path gets the base applied unless it already carries it.
const _base = (import.meta.env.BASE_URL || '/').replace(/\/$/, '');
const ogImagePath = ogImage && !(_base && ogImage.startsWith(_base + '/'))
  ? withBase(ogImage)
  : ogImage;
const ogImageAbs = ogImagePath ? new URL(ogImagePath, Astro.site).href : null;
---

<!doctype html>
<html lang={lang} dir={dir}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />

    <link rel="canonical" href={canonicalURL.href} />
    {alternateEN && alternateAR && (
      <>
        <link rel="alternate" hreflang="en" href={alternateEN} />
        <link rel="alternate" hreflang="ar" href={alternateAR} />
        <link rel="alternate" hreflang="x-default" href={alternateEN} />
      </>
    )}
    <link rel="icon" href={withBase('/favicon.svg')} type="image/svg+xml" />

    {/* Feed autodiscovery (added 2026-08-16). The reader's own language first,
        then the peer feed — a feed reader offers both, which is the point of a
        bilingual publication. Not a nav link: this is the signal readers and
        aggregators look for in <head>, and its absence is why the footer's RSS
        link had nothing behind it from 2026-05-25 to 2026-08-16. */}
    <link
      rel="alternate"
      type="application/rss+xml"
      title={lang === 'ar' ? 'مدار · Madār — العربية' : 'Madār · مدار — English'}
      href={withBase(lang === 'ar' ? '/ar/rss.xml' : '/rss.xml')}
    />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={lang === 'ar' ? 'Madār · مدار — English' : 'مدار · Madār — العربية'}
      href={withBase(lang === 'ar' ? '/rss.xml' : '/ar/rss.xml')}
    />

    {/* Fonts — Cormorant Garamond + Newsreader (Latin), JetBrains Mono, Amiri + Cairo (Arabic).
        Production stand-ins per SYSTEM.md §2; commissioned faces remain TODO. */}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,400;1,500&family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,500;0,6..72,600;1,6..72,400;1,6..72,500&family=JetBrains+Mono:wght@400;500&family=Amiri:ital,wght@0,400;0,700;1,400&family=Cairo:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />

    <meta property="og:type" content={pageType} />
    <meta property="og:site_name" content="Madār · مدار" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL.href} />
    {ogImageAbs && <meta property="og:image" content={ogImageAbs} />}

    {/* og:locale — added 2026-08-24, and it is the Arabic side that needed it.
        The Open Graph default when og:locale is absent is en_US. Every Arabic
        page has therefore been handing scrapers an Arabic title, an Arabic
        description and an implicit claim that it is American English, since the
        first publish on 25 May. The <html lang> was right; nothing in the card
        carried it. This is 08-23's ruling #33 one surface further out: markup
        declaring a language is a claim, and a claim is checked — including the
        claim made by omission.

        The territory suffix the format demands is a genuine awkwardness for a
        publication with no country: `ar_AR` is the conventional territory-free
        form for Modern Standard Arabic, and `en_US` is stated only because it
        is already the spec's silent default, so declaring it asserts nothing
        new while making the alternate pair legible. */}
    <meta property="og:locale" content={lang === 'ar' ? 'ar_AR' : 'en_US'} />
    {alternate && (
      <meta property="og:locale:alternate" content={lang === 'ar' ? 'en_US' : 'ar_AR'} />
    )}

    {/* twitter:card — CONDITIONAL, and it must stay that way (2026-08-26).
        `summary_large_image` is a PROMISE that a large image follows. This tag
        was unconditional, so the five non-article pages — including both front
        doors, / and /ar/, the most-shared URLs we have — promised a card and
        shipped none for 93 days. That is exactly the 2026-08-18 og:image
        defect (a promise kept with nothing), and it survived that day's fix
        because the fix enumerated ARTICLES. The structural repair is not to
        add the image; it is to make the promise IMPOSSIBLE to make without one.
        A page with no image now declares `summary`, which is honest and still
        renders. */}
    <meta name="twitter:card" content={ogImageAbs ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {ogImageAbs && <meta name="twitter:image" content={ogImageAbs} />}

    <meta name="robots" content="index, follow" />
    <meta name="color-scheme" content="light" />

    {jsonLd && (
      <script
        type="application/ld+json"
        set:html={JSON.stringify(jsonLd)}
      />
    )}
  </head>
  <body>
    {/* The skip link is the first thing a screen reader announces. It was
        hardcoded English on every Arabic page until 2026-08-25 — not a lang
        defect but a missing translation, found by qa_a11y_lang. */}
    <a class="skip-link" href="#main">{lang === 'ar' ? 'تخطَّ إلى المحتوى' : 'Skip to content'}</a>
    {!noHeader && <SiteHeader lang={lang} />}
    <main id="main">
      <slot />
    </main>
    <SiteFooter lang={lang} />
  </body>
</html>
