---
import '../styles/global.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { withBase } from '../lib/urls';

interface Props {
  title: string;
  description?: string;
  lang?: 'en' | 'ar';
  ogImage?: string;
  /**
   * If true, suppress the SiteHeader (used when a page renders its own
   * editorial masthead, e.g. an article page).
   */
  noHeader?: boolean;
  /**
   * Head-level hreflang pair (site-absolute paths WITHOUT the base prefix,
   * e.g. { en: '/articles/slug/', ar: '/ar/articles/slug/' }).
   * Only pass when BOTH language versions exist — a pair pointing at a
   * missing page is worse than no pair. The sitemap already carries
   * xhtml:link alternates; this adds the belt-and-suspenders head signal
   * (Growth audit, 2026-07-11). x-default resolves to the EN page.
   */
  alternate?: { en: string; ar: string };
}

const {
  title,
  description = 'An editorial publication on early childhood and K-12 education, written and made in English and Arabic.',
  lang = 'en',
  ogImage,
  noHeader = false,
  alternate,
} = Astro.props;

const dir = lang === 'ar' ? 'rtl' : 'ltr';
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const alternateEN = alternate ? new URL(withBase(alternate.en), Astro.site).href : null;
const alternateAR = alternate ? new URL(withBase(alternate.ar), Astro.site).href : null;
// og:image / twitter:image must be ABSOLUTE for social scrapers (Growth audit,
// 2026-07-16). Callers pass base-prefixed paths; resolve against the site origin.
const ogImageAbs = ogImage ? new URL(ogImage, Astro.site).href : null;
---

<!doctype html>
<html lang={lang} dir={dir}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />

    <link rel="canonical" href={canonicalURL.href} />
    {alternateEN && alternateAR && (
      <>
        <link rel="alternate" hreflang="en" href={alternateEN} />
        <link rel="alternate" hreflang="ar" href={alternateAR} />
        <link rel="alternate" hreflang="x-default" href={alternateEN} />
      </>
    )}
    <link rel="icon" href={withBase('/favicon.svg')} type="image/svg+xml" />

    {/* Feed autodiscovery (added 2026-08-16). The reader's own language first,
        then the peer feed — a feed reader offers both, which is the point of a
        bilingual publication. Not a nav link: this is the signal readers and
        aggregators look for in <head>, and its absence is why the footer's RSS
        link had nothing behind it from 2026-05-25 to 2026-08-16. */}
    <link
      rel="alternate"
      type="application/rss+xml"
      title={lang === 'ar' ? 'مدار · Madār — العربية' : 'Madār · مدار — English'}
      href={withBase(lang === 'ar' ? '/ar/rss.xml' : '/rss.xml')}
    />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={lang === 'ar' ? 'Madār · مدار — English' : 'مدار · Madār — العربية'}
      href={withBase(lang === 'ar' ? '/rss.xml' : '/ar/rss.xml')}
    />

    {/* Fonts — Cormorant Garamond + Newsreader (Latin), JetBrains Mono, Amiri + Cairo (Arabic).
        Production stand-ins per SYSTEM.md §2; commissioned faces remain TODO. */}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,400;1,500&family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,500;0,6..72,600;1,6..72,400;1,6..72,500&family=JetBrains+Mono:wght@400;500&family=Amiri:ital,wght@0,400;0,700;1,400&family=Cairo:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />

    <meta property="og:type" content="article" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL.href} />
    {ogImageAbs && <meta property="og:image" content={ogImageAbs} />}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {ogImageAbs && <meta name="twitter:image" content={ogImageAbs} />}

    <meta name="robots" content="index, follow" />
    <meta name="color-scheme" content="light" />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    {!noHeader && <SiteHeader lang={lang} />}
    <main id="main">
      <slot />
    </main>
    <SiteFooter lang={lang} />
  </body>
</html>
